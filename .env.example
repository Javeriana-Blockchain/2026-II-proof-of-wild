# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (docker compose up -d db)
DATABASE_URL=postgres://pow:pow@localhost:55432/proofofwild

# Stellar testnet
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# Activo de prueba que representa USDC (código y cuenta emisora, que empieza por G)
ASSET_CODE=USDC
ASSET_ISSUER=

# Sesión del portal de centros y validadores: cadena aleatoria de 32 caracteres o más
SESSION_SECRET=

# Almacén local de evidencias (solo desarrollo)
EVIDENCE_DIR=./.data/evidence

# Protege la ruta /api/jobs/reconcile que llama la tarea programada
CRON_SECRET=

# Base de datos DESECHABLE para las pruebas de integración (se vacía en cada ejecución)
TEST_DATABASE_URL=postgres://pow:pow@localhost:55432/proofofwild
