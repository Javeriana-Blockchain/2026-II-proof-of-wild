# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos (npm run db:up). Si el puerto 55432 está ocupado, cambia POW_DB_PORT y el puerto de las URL.
POW_DB_PORT=55432
DATABASE_URL=postgres://pow:pow@127.0.0.1:55432/proofofwild

# Stellar testnet
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# Los escribe `npm run red:preparar`: contrato Proof of Wild y USDC de prueba (emisor y su Stellar Asset Contract)
CONTRACT_ID=
ASSET_CODE=USDC
ASSET_ISSUER=
ASSET_CONTRACT_ID=

# Contraseña de las cuentas de demo que crea el script (administrador y ONG). Si falta, se genera y se muestra una vez.
DEMO_PASSWORD=

# Secreto del servidor (32 caracteres o más): señuelo del inicio de sesión SRP
SESSION_SECRET=

# Almacén local de evidencias: facturas y fotos de hitos (solo desarrollo)
EVIDENCE_DIR=./.data/evidence

# Protege la ruta de reconciliación que llama la tarea programada
CRON_SECRET=

# Base de datos DESECHABLE para las pruebas de integración, distinta de la de la demo (se vacía en cada ejecución).
# Créala una vez: docker compose exec db psql -U pow -d postgres -c "create database proofofwild_test"
TEST_DATABASE_URL=postgres://pow:pow@127.0.0.1:55432/proofofwild_test
